{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/pack-rule/v1alpha1",
  "title": "PackRule v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "stage", "when", "action"],
  "properties": {
    "apiVersion": {"const": "harness.planeon.ai/pack-rule/v1alpha1"},
    "kind": {"const": "PackRule"},
    "id": {"$ref": "#/$defs/id"},
    "stage": {"$ref": "#/$defs/stage"},
    "when": {"$ref": "#/$defs/expression"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "message"],
      "properties": {
        "type": {"enum": ["ASK_QUESTION", "REQUIRE_EVIDENCE", "RECOMMEND_HARNESS", "BLOCK_READINESS"]},
        "target": {"$ref": "#/$defs/id"},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$", "maxLength": 160},
    "field": {"type": "string", "pattern": "^answers\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$", "maxLength": 200},
    "stage": {"enum": ["business-context", "domain-and-outcomes", "data-readiness", "governance-and-regulation", "integration-readiness", "harness-demand", "environment-and-provider-fit", "evidence-and-acceptance"]},
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "expression": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}},
        {"type": "object", "additionalProperties": false, "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/expression"}}}},
        {"type": "object", "additionalProperties": false, "required": ["not"], "properties": {"not": {"$ref": "#/$defs/expression"}}},
        {"type": "object", "additionalProperties": false, "required": ["eq"], "properties": {"eq": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/field"}, {"$ref": "#/$defs/scalar"}], "items": false}}},
        {"type": "object", "additionalProperties": false, "required": ["in"], "properties": {"in": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/field"}, {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scalar"}}], "items": false}}},
        {"type": "object", "additionalProperties": false, "required": ["exists"], "properties": {"exists": {"$ref": "#/$defs/field"}}},
        {"type": "object", "additionalProperties": false, "required": ["gte"], "properties": {"gte": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/field"}, {"type": "number"}], "items": false}}},
        {"type": "object", "additionalProperties": false, "required": ["lte"], "properties": {"lte": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"$ref": "#/$defs/field"}, {"type": "number"}], "items": false}}}
      ]
    }
  }
}
